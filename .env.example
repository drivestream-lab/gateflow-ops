# ── Upstream (gateflow) ──────────────────────
# Server-only. NEVER add NEXT_PUBLIC_* URLs for privileged upstreams.
# Point at the live gateflow base (status BFF probes GET /health here).
UPSTREAM_BASE_URL=http://localhost:8080

# ── Auth ──────────────────────────────────────────────────────────────────────
# dev-stub: local unsigned dev sessions (chassis — NOT for production)
# jwt-upstream: forwards credentials to ${UPSTREAM_BASE_URL}/api/auth/login
#   (gateflow LoginRequest: credential_identifier + password; portal UI still
#    sends email/password and the BFF maps email → credential_identifier)
AUTH_MODE=jwt-upstream
SESSION_COOKIE=portal_session
# Entered programme/tenant ids (ADR-002). httpOnly; not a Bearer. Default: portal_programme_context
#PROGRAMME_CONTEXT_COOKIE=portal_programme_context

# ── Logging (see product/06-logging.md) ──────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=true
LOG_UPSTREAM_CALLS=true
# Edge middleware inbound lines: unset = dev-only; "true" = always; "false" = off
#LOG_API_INBOUND=
#LOG_REQUESTS=
