# ── Upstream (gateflow) ──────────────────────
# Server-only. NEVER add NEXT_PUBLIC_* URLs for privileged upstreams.
# Default points at the built-in dev echo so the hello-world page works before
# any real upstream exists. Pointing this at the real API is your first task.
# NOTE: the dev echo lives on THIS app's port — if `next dev` picks a different
# port (3000 busy → 3001), update this value to match.
UPSTREAM_BASE_URL=http://localhost:3000

# ── Auth ──────────────────────────────────────────────────────────────────────
# dev-stub: local unsigned dev sessions (chassis default — NOT for production)
# jwt-upstream: forwards credentials to ${UPSTREAM_BASE_URL}/v1/auth/login
AUTH_MODE=dev-stub
SESSION_COOKIE=portal_session

# ── Logging (see product/06-logging.md) ──────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=true
LOG_UPSTREAM_CALLS=true
# Edge middleware inbound lines: unset = dev-only; "true" = always; "false" = off
#LOG_API_INBOUND=
#LOG_REQUESTS=
